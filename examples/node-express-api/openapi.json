{
  "openapi": "3.0.0",
  "info": {
    "title": "Spectra Demo API - Node.js Express",
    "description": "A lightweight REST API built with Node.js and Express, designed for demonstrating Spectra's comprehensive testing capabilities. This API provides full CRUD operations for user management with comprehensive validation and error handling.",
    "version": "1.0.0",
    "contact": {
      "name": "Spectra Demo Support",
      "email": "demo@spectra.dev"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3000",
      "description": "Local development server (Node.js Express)"
    }
  ],
  "paths": {
    "/api/v1/users": {
      "get": {
        "summary": "Get all users",
        "description": "Retrieve a list of all users in the system",
        "operationId": "getAllUsers",
        "tags": ["Users"],
        "responses": {
          "200": {
            "description": "List of users retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                },
                "example": [
                  {
                    "id": 1,
                    "name": "John Doe",
                    "email": "john.doe@example.com",
                    "age": 30,
                    "department": "Engineering"
                  }
                ]
              }
            }
          }
        }
      },
      "post": {
        "summary": "Create a new user",
        "description": "Create a new user in the system with validation. Email must be unique.",
        "operationId": "createUser",
        "tags": ["Users"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateUserRequest"
              },
              "example": {
                "name": "Alice Johnson",
                "email": "alice.johnson@example.com",
                "age": 25,
                "department": "Marketing"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "User created successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Validation error or duplicate email",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/{id}": {
      "get": {
        "summary": "Get user by ID",
        "description": "Retrieve a specific user by their ID. Returns 500 error for ID 999 to test error handling.",
        "operationId": "getUserById",
        "tags": ["Users"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "description": "User ID"
          }
        ],
        "responses": {
          "200": {
            "description": "User found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundError"
                }
              }
            }
          },
          "500": {
            "description": "Server error (when ID is 999 for testing)",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ServerError"
                }
              }
            }
          }
        }
      },
      "put": {
        "summary": "Update user",
        "description": "Update an existing user's information. Email must be unique among all users.",
        "operationId": "updateUser",
        "tags": ["Users"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "description": "User ID"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UpdateUserRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User updated successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/User"
                }
              }
            }
          },
          "400": {
            "description": "Validation error or duplicate email",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "summary": "Delete user",
        "description": "Remove a user from the system",
        "operationId": "deleteUser",
        "tags": ["Users"],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "format": "int64",
              "minimum": 1
            },
            "description": "User ID"
          }
        ],
        "responses": {
          "204": {
            "description": "User deleted successfully"
          },
          "404": {
            "description": "User not found",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NotFoundError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/department/{department}": {
      "get": {
        "summary": "Get users by department",
        "description": "Retrieve all users belonging to a specific department (case-insensitive)",
        "operationId": "getUsersByDepartment",
        "tags": ["Users"],
        "parameters": [
          {
            "name": "department",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "minLength": 1
            },
            "description": "Department name",
            "example": "Engineering"
          }
        ],
        "responses": {
          "200": {
            "description": "Users in department retrieved successfully",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/User"
                  }
                }
              }
            }
          },
          "400": {
            "description": "Invalid department parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users/reset-test-data": {
      "post": {
        "summary": "Reset test data",
        "description": "Reset the user database to initial demo data. Useful for test isolation and demonstration purposes.",
        "operationId": "resetTestData",
        "tags": ["Admin"],
        "responses": {
          "200": {
            "description": "Test data reset successfully",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ResetResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "summary": "Health check",
        "description": "Get application health status and metrics",
        "operationId": "healthCheck",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "Service is healthy",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "User": {
        "type": "object",
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64",
            "description": "Unique user identifier",
            "example": 1
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50,
            "description": "User's full name",
            "example": "John Doe"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "User's email address",
            "example": "john.doe@example.com"
          },
          "age": {
            "type": "integer",
            "minimum": 18,
            "maximum": 100,
            "description": "User's age",
            "example": 30,
            "nullable": true
          },
          "department": {
            "type": "string",
            "description": "User's department",
            "example": "Engineering",
            "nullable": true
          }
        },
        "required": ["id", "name", "email"]
      },
      "CreateUserRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50,
            "description": "User's full name",
            "example": "Alice Johnson"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "User's email address",
            "example": "alice.johnson@example.com"
          },
          "age": {
            "type": "integer",
            "minimum": 18,
            "maximum": 100,
            "description": "User's age",
            "example": 25
          },
          "department": {
            "type": "string",
            "description": "User's department",
            "example": "Marketing"
          }
        },
        "required": ["name", "email"]
      },
      "UpdateUserRequest": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 50,
            "description": "User's full name",
            "example": "John Smith"
          },
          "email": {
            "type": "string",
            "format": "email",
            "description": "User's email address",
            "example": "john.smith@example.com"
          },
          "age": {
            "type": "integer",
            "minimum": 18,
            "maximum": 100,
            "description": "User's age",
            "example": 31
          },
          "department": {
            "type": "string",
            "description": "User's department",
            "example": "Engineering"
          }
        },
        "required": ["name", "email"]
      },
      "ValidationError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Validation failed"
          },
          "message": {
            "type": "string",
            "example": "Email already exists"
          },
          "details": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "type": { "type": "string" },
                "msg": { "type": "string" },
                "path": { "type": "string" },
                "location": { "type": "string" }
              }
            }
          }
        }
      },
      "NotFoundError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "User not found"
          },
          "message": {
            "type": "string",
            "example": "User with ID 123 does not exist"
          }
        }
      },
      "ServerError": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "Internal Server Error"
          },
          "message": {
            "type": "string",
            "example": "Simulated server error for testing"
          }
        }
      },
      "ResetResponse": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "example": "Test data reset successfully"
          },
          "userCount": {
            "type": "integer",
            "example": 3
          },
          "availableIds": {
            "type": "array",
            "items": {
              "type": "integer"
            },
            "example": [1, 2, 3]
          }
        }
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "example": "healthy"
          },
          "timestamp": {
            "type": "string",
            "format": "date-time",
            "example": "2024-01-15T10:30:00.000Z"
          },
          "uptime": {
            "type": "number",
            "description": "Server uptime in seconds",
            "example": 3600.5
          },
          "users": {
            "type": "integer",
            "description": "Current number of users in the system",
            "example": 3
          }
        }
      }
    }
  },
  "tags": [
    {
      "name": "Users",
      "description": "User management operations - CRUD operations for managing user data"
    },
    {
      "name": "Admin",
      "description": "Administrative operations - System management and testing utilities"
    },
    {
      "name": "System",
      "description": "System operations - Health checks and monitoring"
    }
  ]
}
