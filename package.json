{
  "name": "spectra",
  "version": "0.3.0",
  "description": "AI-powered API testing automation for demo-api",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "spectra-enhanced": "dist/src/cli/enhanced.js"
  },
  "engines": {
    "node": ">=16"
  },
  "scripts": {
    "build": "tsc",
    "dev": "ts-node src/index.ts",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write \"src/**/*.ts\"",
    "generate:spec:demo-api": "ts-node src/index.ts generate-spec examples/demo-api ./examples/demo-api/enrichedOpenapi.json",
    "test:demo-api:intelligent": "ts-node src/cli/enhanced.ts run-intelligent-testing examples/demo-api/openapi.json",
    "test:demo-api:intelligent_2": "ts-node src/cli/enhanced.ts run-intelligent-testing examples/node-express-api/openapi.json",
    "setup:git-hooks": "./setup-git-hooks.sh",
    
    "cli:info": "ts-node src/cli/enhanced.ts info",
    "cli:check-env": "ts-node src/cli/enhanced.ts check-env",
    "cli:run:intel:default": "ts-node src/cli/enhanced.ts run-intelligent-testing ./examples/node-express-api/openapi.json",
    "cli:run:intel:code-root": "ts-node src/cli/enhanced.ts run-intelligent-testing ./examples/node-express-api/openapi.json --code-root ./examples/node-express-api",
    "cli:run:intel:depth": "ts-node src/cli/enhanced.ts run-intelligent-testing ./examples/node-express-api/openapi.json --context-depth 2000",
    "cli:run:intel:self-heal": "ts-node src/cli/enhanced.ts run-intelligent-testing ./examples/node-express-api/openapi.json --self-heal --max-retries 2",
    "cli:run:intel:all": "ts-node src/cli/enhanced.ts run-intelligent-testing ./examples/node-express-api/openapi.json --code-root ./examples/node-express-api --context-depth 2000 --self-heal --max-retries 2",
    "cli:run:intel:custom": "ts-node src/cli/enhanced.ts run-intelligent-testing",

    "docker:build": "docker build -t spectra-pilot:0.3.0 .",
    "docker:run:info": "docker run --rm spectra-pilot:0.3.0 info",
    "docker:run:check-env": "docker run --rm -e OPENAI_API_KEY=$OPENAI_API_KEY spectra-pilot:0.3.0 check-env",
    "docker:run:test": "docker run --rm -e OPENAI_API_KEY=$OPENAI_API_KEY -v \"$PWD:/work\" spectra-pilot:0.3.0 run-intelligent-testing /work/examples/node-express-api/openapi.json",
    "docker:run:intel:default": "docker run --rm -e OPENAI_API_KEY=$OPENAI_API_KEY -v \"$PWD:/work\" spectra-pilot:0.3.0 run-intelligent-testing /work/examples/node-express-api/openapi.json",
    "docker:run:intel:code-root": "docker run --rm -e OPENAI_API_KEY=$OPENAI_API_KEY -v \"$PWD:/work\" spectra-pilot:0.3.0 run-intelligent-testing /work/examples/node-express-api/openapi.json --code-root /work/examples/node-express-api",
    "docker:run:intel:depth": "docker run --rm -e OPENAI_API_KEY=$OPENAI_API_KEY -v \"$PWD:/work\" spectra-pilot:0.3.0 run-intelligent-testing /work/examples/node-express-api/openapi.json --context-depth 2000",
    "docker:run:intel:self-heal": "docker run --rm -e OPENAI_API_KEY=$OPENAI_API_KEY -v \"$PWD:/work\" spectra-pilot:0.3.0 run-intelligent-testing /work/examples/node-express-api/openapi.json --self-heal --max-retries 2",
    "docker:run:intel:all": "docker run --rm -e OPENAI_API_KEY=$OPENAI_API_KEY -v \"$PWD:/work\" spectra-pilot:0.3.0 run-intelligent-testing /work/examples/node-express-api/openapi.json --code-root /work/examples/node-express-api --context-depth 2000 --self-heal --max-retries 2",
    "docker:run:intel:custom": "docker run --rm -e OPENAI_API_KEY=$OPENAI_API_KEY -v \"$PWD:/work\" spectra-pilot:0.3.0 run-intelligent-testing",
    "docker:save": "docker save spectra-pilot:0.3.0 | gzip > spectra-pilot_0.3.0.tar.gz"
  },
  "keywords": [
    "api",
    "testing",
    "automation",
    "gherkin",
    "regression",
    "ai",
    "curl"
  ],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@apidevtools/json-schema-ref-parser": "^12.0.1",
    "@faker-js/faker": "^9.7.0",
    "@langchain/core": "^0.3.61",
    "@langchain/langgraph": "^0.3.5",
    "@langchain/openai": "^0.5.16",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.1",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "axios": "^1.8.4",
    "commander": "^14.0.0",
    "cucumber": "^6.0.7",
    "dotenv": "^16.5.0",
    "form-data": "^4.0.0",
    "gherkin-parse": "^1.0.12",
    "jest": "^29.7.0",
    "openai": "^4.93.0",
    "openapi-parser": "^0.2.0",
    "openapi-types": "^12.1.3",
    "repomix": "^0.3.9",
    "swagger-parser": "^10.0.3",
    "ts-jest": "^29.3.2",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/glob": "^8.1.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "^8.29.1",
    "@typescript-eslint/parser": "^8.29.1",
    "eslint": "^9.24.0",
    "eslint-config-prettier": "^10.1.2",
    "prettier": "^3.5.3"
  }
}
